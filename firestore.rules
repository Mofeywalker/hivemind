rules_version = '2';

// Trust model
// -----------
// The client is untrusted. Membership is never asserted by a client write:
// `createHivemind` / `joinHivemind` in functions/src/index.ts are the only paths
// that may add a uid to hiveminds/{id}.member_ids, and they run with the Admin
// SDK (rules are bypassed there). Invite codes are therefore a server-verified
// secret and are not readable by non-members.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMemberOf(hivemindId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/hiveminds/$(hivemindId)/members/$(request.auth.uid)
      );
    }

    function changedKeysAre(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // User Profiles & FCM Tokens: private to their owner.
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;

      allow create, update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(
          ['display_name', 'email', 'avatar_url', 'fcm_token', 'timezone', 'created_at', 'updated_at']
        ) &&
        request.resource.data.get('email', '') is string &&
        request.resource.data.get('email', '').size() <= 254 &&
        request.resource.data.get('display_name', '') is string &&
        request.resource.data.get('display_name', '').size() <= 80 &&
        request.resource.data.get('avatar_url', '') is string &&
        request.resource.data.get('avatar_url', '').size() <= 2048 &&
        request.resource.data.get('fcm_token', '') is string &&
        request.resource.data.get('fcm_token', '').size() <= 4096 &&
        request.resource.data.get('timezone', '') is string &&
        request.resource.data.get('timezone', '').size() <= 64;

      allow list, delete: if false;
    }

    // Hiveminds (Circles/Groups)
    match /hiveminds/{hivemindId} {
      // Members only: no collection enumeration, no invite_code disclosure.
      allow get: if isMemberOf(hivemindId);
      allow list: if isSignedIn() && request.auth.uid in resource.data.member_ids;

      // Creation goes through the createHivemind callable (server-generated,
      // unique invite code). Deletion is not implemented client-side.
      allow create, delete: if false;

      // Renaming only. member_ids / invite_code / created_by / created_at are
      // immutable for clients, so nobody can join by rewriting membership and
      // nobody can rotate the code to lock members out or hijack a group.
      allow update: if isMemberOf(hivemindId) &&
        changedKeysAre(['name', 'description', 'icon', 'updated_at']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 60 &&
        (request.resource.data.get('description', null) == null ||
          (request.resource.data.description is string &&
            request.resource.data.description.size() <= 300)) &&
        request.resource.data.icon is string &&
        request.resource.data.icon.size() <= 8;

      // Members Subcollection: readable by members, written only by the
      // joinHivemind / createHivemind callables (role is never client-set).
      match /members/{memberId} {
        allow get, list: if isMemberOf(hivemindId);
        allow write: if false;
      }
    }

    // Reminders
    match /reminders/{reminderId} {
      function reminderKeys() {
        return [
          'id', 'hivemind_id', 'title', 'notes', 'due_at', 'rrule',
          'is_completed', 'completed_at', 'completed_by', 'completed_by_ids',
          'created_by', 'completion_scope', 'assigned_to', 'created_at', 'updated_at'
        ];
      }

      function reminderFieldsAreValid() {
        return request.resource.data.title is string &&
          request.resource.data.title.size() >= 1 &&
          request.resource.data.title.size() <= 200 &&
          (request.resource.data.get('notes', null) == null ||
            (request.resource.data.notes is string &&
              request.resource.data.notes.size() <= 2000)) &&
          request.resource.data.get('hivemind_id', '') is string &&
          request.resource.data.get('hivemind_id', '').size() > 0;
      }

      allow get, list, delete: if isSignedIn() &&
        isMemberOf(resource.data.hivemind_id);

      allow create: if isSignedIn() &&
        isMemberOf(request.resource.data.hivemind_id) &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.keys().hasOnly(reminderKeys()) &&
        reminderFieldsAreValid();

      // A reminder can never be moved between hiveminds or re-attributed:
      // both would let a member of one group inject content (and push
      // notifications) into another group.
      allow update: if isSignedIn() &&
        isMemberOf(resource.data.hivemind_id) &&
        changedKeysAre([
          'title', 'notes', 'due_at', 'rrule', 'updated_at',
          'completion_scope', 'assigned_to', 'is_completed', 'completed_at',
          'completed_by', 'completed_by_ids'
        ]) &&
        reminderFieldsAreValid();
    }
  }
}
